Question 5: Plot Tesla Stock Graph
Use the make_graph function to graph the Tesla Stock Data, also provide a title for the graph.

import yfinance as yf
import pandas as pd
import plotly.graph_objects as go
from plotly.subplots import make_subplots

# download data 
tsla = yf.Ticker("TSLA")
tsla_data = tsla.history(period="24mo")  # Fetching 1 month of historical data
tsla_data.reset_index(inplace=True)  # Reset index for proper date handling

# graph
def make_graph(stock_data, stock):
    fig = make_subplots(rows=2, cols=1, shared_xaxes=True, subplot_titles=["Stock Price", "Revenue"], vertical_spacing=0.2)

    fig.add_trace(go.Scatter(x=stock_data["Date"], y=stock_data["Close"], name="Stock Price"), row=1, col=1)
    fig.update_layout(title=f"{stock} Stock & Revenue", height=600, xaxis_rangeslider_visible=True)
    fig.show()

# Plot Tesla graph
make_graph(tsla_data, "Tesla (TSLA)")

